{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/local.settings.json)",
      "Edit(**/local.settings.json)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(~/.microsoft/usersecrets/**)",
      "Edit(~/.microsoft/usersecrets/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(az keyvault secret show *)",
      "Bash(az keyvault secret download *)",
      "Bash(az keyvault certificate download *)",
      "Bash(az keyvault key download *)",
      "Bash(az account get-access-token *)"
    ],
    "ask": [
      "Edit(**/appsettings*.json)",
      "Bash(az * create *)",
      "Bash(az * delete *)",
      "Bash(az * update *)",
      "Bash(az * set *)",
      "Bash(az * add *)",
      "Bash(az * remove *)",
      "Bash(az * assign *)",
      "Bash(az * purge *)",
      "Bash(az * import *)",
      "Bash(az * restore *)",
      "Bash(az * recover *)",
      "Bash(az * reset *)",
      "Bash(az * rotate *)",
      "Bash(az * renew *)",
      "Bash(az * start *)",
      "Bash(az * stop *)",
      "Bash(az * restart *)",
      "Bash(az * deploy *)",
      "Bash(az * upload *)",
      "Bash(az * invoke *)",
      "Bash(az * sync *)",
      "Bash(az * swap *)",
      "Bash(az * scale *)",
      "Bash(az * enable *)",
      "Bash(az * disable *)",
      "Bash(az rest *)",
      "Bash(az extension *)",
      "Bash(az login *)",
      "Bash(az logout *)"
    ]
  },
  "enabledPlugins": {
    "postman@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": false
}
